{
  "id": null,
  "uid": "country-service",
  "title": "Country service verification",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Ready scrape targets",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "country-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(up{job=\"country-app\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "country-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"country-app\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP p95 seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "country-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{job=\"country-app\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Country operation outcomes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "country-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by(operation,outcome)(country_operations_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Import duration seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "country-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(country_import_duration_seconds_sum) / clamp_min(sum(country_import_duration_seconds_count),1)",
          "refId": "A"
        }
      ]
    }
  ]
}
